# Notion
NOTION_TOKEN=secret_xxx
NOTION_PARENT_PAGE_ID=
NOTION_APP_PAGE_ID=
NOTION_SERIES_DATABASE_ID=
NOTION_OCCURRENCES_DATABASE_ID=
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PAGE_NAME=Meeting Pilot
NOTION_TITLE_PROPERTY=Name
NOTION_PROJECT_PROPERTY=Project
NOTION_INCLUDE_OVERVIEW=true
NOTION_INCLUDE_SUMMARY=true
NOTION_INCLUDE_TOPICS=true
NOTION_INCLUDE_DECISIONS=true
NOTION_INCLUDE_ACTION_ITEMS=true
NOTION_INCLUDE_OPEN_QUESTIONS=true
NOTION_INCLUDE_RISKS=true
NOTION_INCLUDE_SPEAKERS=true
NOTION_INCLUDE_TRANSCRIPT=true

# Local Diary: default fallback when no publication target is selected.
# Each meeting is a Markdown page; index.sqlite is only a rebuildable local index.
JOURNAL_ROOT="~/Library/Application Support/Meeting Pilot/Diary"
# PUBLISH_TARGETS=journal,notion

# Summary provider: any OpenAI-compatible chat completions API.
# Default OpenAI-compatible example:
SUMMARY_ENABLED=true
SUMMARY_PROVIDER_MODE=api
LOCAL_MODELS_DIR=~/.omlx/models
SUMMARY_BASE_URL=https://api.openai.com/v1
SUMMARY_MODEL=gpt-4.1-mini
SUMMARY_API_KEY=sk-...
REMOTE_SUMMARY_API_KEY=sk-...
LOCAL_SUMMARY_API_KEY=
SUMMARY_RESPONSE_FORMAT_JSON=true

# Local oMLX example:
# SUMMARY_PROVIDER_MODE=local
# SUMMARY_BASE_URL=http://127.0.0.1:8000/v1
# SUMMARY_MODEL=Qwen3-4B-Instruct-2507-4bit
# SUMMARY_API_KEY=
# LOCAL_SUMMARY_API_KEY=
# SUMMARY_RESPONSE_FORMAT_JSON=false

# Folders
MEETINGS_ROOT=~/TeamsMeetings
RECORDER_MODE=macos_prompt
INBOX_AUDIO_DIR=~/TeamsMeetings/inbox_audio
RECORDING_PROMPT_ENABLED=true
RECORDING_PROMPT_DELAY_SECONDS=3
# What the built-in recorder captures when no call is detected: microphone, system or both.
# A detected call always records both.
RECORDING_AUDIO_SOURCE=both
# Who the notes are for: worker (meeting notes), student (study notes) or both.
USER_PROFILE=worker
# RECORDER_OPEN_TARGET=/Applications/YourRecorder.app
MOVE_SOURCE_AUDIO=false
# Keep the recording after publishing; notes then link to the archived audio file.
KEEP_AUDIO=false

# Local calendar metadata
CALENDAR_METADATA_ENABLED=true
CALENDAR_LOOKUP_WINDOW_MINUTES=90
OUTLOOK_SQLITE_PATH=~/Library/Group Containers/UBF8T346G9.Office/Outlook/Outlook 15 Profiles/Main Profile/Data/Outlook.sqlite
TEAMS_RUNTIME_METADATA_FILE=~/TeamsMeetings/teams-runtime.json

# Transcription
TRANSCRIPTION_PROVIDER=fluid
TRANSCRIPTION_LOCALE=it-IT
APPLE_TRANSCRIBER_TIMEOUT_SECONDS=240
APPLE_TRANSCRIBER_CMD="macos/MeetingPilot/build/Meeting Pilot.app/Contents/MacOS/AppleTranscriber"
FLUID_AUDIO_CMD=

# Watcher
WATCH_POLL_SECONDS=5
FILE_STABLE_SECONDS=10
