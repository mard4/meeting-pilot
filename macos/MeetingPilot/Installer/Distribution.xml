<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
  <title>Meeting Pilot</title>
  <options customize="never" require-scripts="false"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>

  <welcome file="Welcome.html" mime-type="text/html"/>
  <readme file="ReadMe.html" mime-type="text/html"/>
  <conclusion file="Conclusion.html" mime-type="text/html"/>

  <choices-outline>
    <line choice="meeting-pilot"/>
  </choices-outline>

  <choice id="meeting-pilot" title="Meeting Pilot">
    <pkg-ref id="io.github.mard4.MeetingPilot.pkg"/>
  </choice>

  <pkg-ref id="io.github.mard4.MeetingPilot.pkg" version="@VERSION@" onConclusion="none">MeetingPilot-component.pkg</pkg-ref>
</installer-gui-script>
